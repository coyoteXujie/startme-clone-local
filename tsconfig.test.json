{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": ["chrome"]
  },
  "include": [
    "src/types/**/*.ts",
    "src/utils/url.ts",
    "src/utils/widgetDefaults.ts",
    "src/utils/widgetDrag.ts",
    "src/utils/storage.ts"
  ]
}
